# Copy this to .env and fill in values before running docker-compose

# Required: generate with `make gen-key`, or:
# docker run --rm python:3.13-slim sh -c "pip -q install cryptography && python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'"
SECRET_KEY=CHANGE_ME_generate_with_fernet_command_above

# Sign-in. Leave SFS_PASSWORD blank to set the password in the browser with the
# setup code printed by `docker compose logs backend`; or set it here (8+
# characters) and it wins at every start. SFS_AUTH=none turns sign-in off: only
# behind a proxy that signs people in itself.
# SFS_PASSWORD=
# SFS_AUTH=password

# Port the UI is available on (default: 8080)
FRONTEND_PORT=8080

# Metadata database (projects, runs, connections). Default: SQLite in the data
# volume. PostgreSQL for more than one user (psycopg is already installed):
# METADATA_DB_URL=postgresql+psycopg://user:pass@postgres:5432/flowstudio

# Optional pip extras baked into the backend image (default: all-connectors,pushdown).
# Narrow it for a smaller image, e.g. SFS_EXTRAS=trino,pushdown — any extras from
# backend/pyproject.toml, comma-separated. Set it empty (SFS_EXTRAS=) for core engines only.
# Takes effect on the next image build (docker compose build / up --build).
# SFS_EXTRAS=all-connectors,pushdown

# Plugins from plugins/ baked into the backend image, by short name
# (sfs-plugin-<name>), comma-separated (default: curvefit,tm1,powerbi). SFS_PLUGINS= for none.
# SFS_PLUGINS=curvefit,tm1,powerbi

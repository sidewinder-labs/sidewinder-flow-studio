# Settings for running the backend from source: development only, see
# CONTRIBUTING.md. Users run the desktop app or Docker (docs/INSTALLATION.md);
# Docker takes its settings from .env.docker and docker-compose.yml.

HOST=0.0.0.0
PORT=8000
DEBUG=true

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=CHANGE_ME_run_command_above

METADATA_DB_URL=sqlite+aiosqlite:///./flow_studio.db
PROJECTS_DIR=./projects
FRAME_CACHE_DIR=./frame_cache

# Optional — enables the AI agent for generating processor and chart code.
# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Reports & persist (Explore/Report nodes, right-click Persist)
REPORTS_DIR=./reports_data
PERSIST_DB=./reports_data/persist.duckdb
# URL of the optional Streamlit viewer (docker compose --profile reports up)
REPORTS_URL=http://localhost:8501

# Enterprise scheduler failure alerting
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=sfs@localhost
